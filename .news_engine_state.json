    "\u0db4\u0dac\u0dd4\u0dc0\u0dc3\u0dca\u0db1\u0dd4\u0dc0\u0dbb \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0db4\u0dcf\u0dbd\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db4\u0dbb\u0dcf\u0daf\u0dba\u0dd2",
    "\u0d86\u0db4\u0daf\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0dc3\u0dc4\u0db1 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd3\u0db8 \u0db8\u0dd9\u0db1\u0dca\u0db8 \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dad\u0dca \u0dbb\u0da2\u0dba\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u2013 \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2",
    "\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a 4\u0d9a\u0da7 \u0db1\u0dcf\u0dba\u0dba\u0dcf\u0db8\u0dda \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8\u0dca",
    "\u0dbb\u0da7 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d9c\u0dad\u0dca \u0dc0\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da7\u0dad\u0db8 \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0da7 \u0d85\u0daf\u0da7 \u0dc0\u0dc3\u0dbb\u0dba\u0dd2",
    "\u0d91\u0d82\u0d9c\u0dbd\u0db1\u0dca\u0dad\u0dba\u0da7 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 55\u0d9a \u0da2\u0dba\u0d9a\u0dca",
    "\u0db4\u0dac\u0dd4\u0dc0\u0dc3\u0dca\u0db1\u0dd4\u0dc0\u0dbb \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0db4\u0dcf\u0dbd\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db4\u0dbb\u0dcf\u0daf\u0dba\u0dd2",
    "\u0d86\u0db4\u0daf\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0dc3\u0dc4\u0db1 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd3\u0db8 \u0db8\u0dd9\u0db1\u0dca\u0db8 \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dad\u0dca \u0dbb\u0da2\u0dba\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u2013 \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2",
    "\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a 4\u0d9a\u0da7 \u0db1\u0dcf\u0dba\u0dba\u0dcf\u0db8\u0dda \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8\u0dca",
    "\u0dbb\u0da7 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d9c\u0dad\u0dca \u0dc0\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da7\u0dad\u0db8 \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0da7 \u0d85\u0daf\u0da7 \u0dc0\u0dc3\u0dbb\u0dba\u0dd2",
    "\u0d91\u0d82\u0d9c\u0dbd\u0db1\u0dca\u0dad\u0dba\u0da7 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 55\u0d9a \u0da2\u0dba\u0d9a\u0dca",
    "\u0db4\u0dac\u0dd4\u0dc0\u0dc3\u0dca\u0db1\u0dd4\u0dc0\u0dbb \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0db4\u0dcf\u0dbd\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db4\u0dbb\u0dcf\u0daf\u0dba\u0dd2",
    "\u0d86\u0db4\u0daf\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0dc3\u0dc4\u0db1 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd3\u0db8 \u0db8\u0dd9\u0db1\u0dca\u0db8 \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dad\u0dca \u0dbb\u0da2\u0dba\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u2013 \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2",
    "\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a 4\u0d9a\u0da7 \u0db1\u0dcf\u0dba\u0dba\u0dcf\u0db8\u0dda \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8\u0dca",
    "\u0dbb\u0da7 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d9c\u0dad\u0dca \u0dc0\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da7\u0dad\u0db8 \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0da7 \u0d85\u0daf\u0da7 \u0dc0\u0dc3\u0dbb\u0dba\u0dd2",
    "\u0d91\u0d82\u0d9c\u0dbd\u0db1\u0dca\u0dad\u0dba\u0da7 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 55\u0d9a \u0da2\u0dba\u0d9a\u0dca",
    "\u0db4\u0dac\u0dd4\u0dc0\u0dc3\u0dca\u0db1\u0dd4\u0dc0\u0dbb \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0db4\u0dcf\u0dbd\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db4\u0dbb\u0dcf\u0daf\u0dba\u0dd2",
    "\u0d86\u0db4\u0daf\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0dc3\u0dc4\u0db1 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd3\u0db8 \u0db8\u0dd9\u0db1\u0dca\u0db8 \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dad\u0dca \u0dbb\u0da2\u0dba\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u2013 \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2",
    "\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a 4\u0d9a\u0da7 \u0db1\u0dcf\u0dba\u0dba\u0dcf\u0db8\u0dda \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8\u0dca",
    "\u0dbb\u0da7 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d9c\u0dad\u0dca \u0dc0\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da7\u0dad\u0db8 \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0da7 \u0d85\u0daf\u0da7 \u0dc0\u0dc3\u0dbb\u0dba\u0dd2",
    "\u0d91\u0d82\u0d9c\u0dbd\u0db1\u0dca\u0dad\u0dba\u0da7 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 55\u0d9a \u0da2\u0dba\u0d9a\u0dca",
    "\u0db4\u0dac\u0dd4\u0dc0\u0dc3\u0dca\u0db1\u0dd4\u0dc0\u0dbb \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0db4\u0dcf\u0dbd\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db4\u0dbb\u0dcf\u0daf\u0dba\u0dd2",
    "\u0d86\u0db4\u0daf\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0dc3\u0dc4\u0db1 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd3\u0db8 \u0db8\u0dd9\u0db1\u0dca\u0db8 \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dad\u0dca \u0dbb\u0da2\u0dba\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u2013 \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2",
    "\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a 4\u0d9a\u0da7 \u0db1\u0dcf\u0dba\u0dba\u0dcf\u0db8\u0dda \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8\u0dca",
    "\u0dbb\u0da7 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d9c\u0dad\u0dca \u0dc0\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da7\u0dad\u0db8 \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0da7 \u0d85\u0daf\u0da7 \u0dc0\u0dc3\u0dbb\u0dba\u0dd2",
    "\u0d91\u0d82\u0d9c\u0dbd\u0db1\u0dca\u0dad\u0dba\u0da7 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 55\u0d9a \u0da2\u0dba\u0d9a\u0dca",
    "\u0db4\u0dac\u0dd4\u0dc0\u0dc3\u0dca\u0db1\u0dd4\u0dc0\u0dbb \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0db4\u0dcf\u0dbd\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db4\u0dbb\u0dcf\u0daf\u0dba\u0dd2",
    "\u0d86\u0db4\u0daf\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0dc3\u0dc4\u0db1 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd3\u0db8 \u0db8\u0dd9\u0db1\u0dca\u0db8 \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dad\u0dca \u0dbb\u0da2\u0dba\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u2013 \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2",
    "\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a 4\u0d9a\u0da7 \u0db1\u0dcf\u0dba\u0dba\u0dcf\u0db8\u0dda \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8\u0dca",
    "\u0dbb\u0da7 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d9c\u0dad\u0dca \u0dc0\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da7\u0dad\u0db8 \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0da7 \u0d85\u0daf\u0da7 \u0dc0\u0dc3\u0dbb\u0dba\u0dd2",
    "\u0d91\u0d82\u0d9c\u0dbd\u0db1\u0dca\u0dad\u0dba\u0da7 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 55\u0d9a \u0da2\u0dba\u0d9a\u0dca",
    "\u0db4\u0dac\u0dd4\u0dc0\u0dc3\u0dca\u0db1\u0dd4\u0dc0\u0dbb \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0db4\u0dcf\u0dbd\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db4\u0dbb\u0dcf\u0daf\u0dba\u0dd2",
    "\u0d86\u0db4\u0daf\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0dc3\u0dc4\u0db1 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd3\u0db8 \u0db8\u0dd9\u0db1\u0dca\u0db8 \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dad\u0dca \u0dbb\u0da2\u0dba\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u2013 \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2",
    "\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a 4\u0d9a\u0da7 \u0db1\u0dcf\u0dba\u0dba\u0dcf\u0db8\u0dda \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8\u0dca",
    "\u0dbb\u0da7 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d9c\u0dad\u0dca \u0dc0\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da7\u0dad\u0db8 \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0da7 \u0d85\u0daf\u0da7 \u0dc0\u0dc3\u0dbb\u0dba\u0dd2",
    "\u0d91\u0d82\u0d9c\u0dbd\u0db1\u0dca\u0dad\u0dba\u0da7 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 55\u0d9a \u0da2\u0dba\u0d9a\u0dca",
    "\u0db4\u0dac\u0dd4\u0dc0\u0dc3\u0dca\u0db1\u0dd4\u0dc0\u0dbb \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0db4\u0dcf\u0dbd\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db4\u0dbb\u0dcf\u0daf\u0dba\u0dd2",
    "\u0d86\u0db4\u0daf\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0dc3\u0dc4\u0db1 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd3\u0db8 \u0db8\u0dd9\u0db1\u0dca\u0db8 \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dad\u0dca \u0dbb\u0da2\u0dba\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u2013 \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2",
    "\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a 4\u0d9a\u0da7 \u0db1\u0dcf\u0dba\u0dba\u0dcf\u0db8\u0dda \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8\u0dca",
    "\u0dbb\u0da7 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d9c\u0dad\u0dca \u0dc0\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da7\u0dad\u0db8 \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0da7 \u0d85\u0daf\u0da7 \u0dc0\u0dc3\u0dbb\u0dba\u0dd2",
    "\u0d91\u0d82\u0d9c\u0dbd\u0db1\u0dca\u0dad\u0dba\u0da7 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 55\u0d9a \u0da2\u0dba\u0d9a\u0dca",
    "\u0db4\u0dac\u0dd4\u0dc0\u0dc3\u0dca\u0db1\u0dd4\u0dc0\u0dbb \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0db4\u0dcf\u0dbd\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db4\u0dbb\u0dcf\u0daf\u0dba\u0dd2",
    "\u0d86\u0db4\u0daf\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0dc3\u0dc4\u0db1 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd3\u0db8 \u0db8\u0dd9\u0db1\u0dca\u0db8 \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dad\u0dca \u0dbb\u0da2\u0dba\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u2013 \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2",
    "\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a 4\u0d9a\u0da7 \u0db1\u0dcf\u0dba\u0dba\u0dcf\u0db8\u0dda \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8\u0dca",
    "\u0dbb\u0da7 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d9c\u0dad\u0dca \u0dc0\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da7\u0dad\u0db8 \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0da7 \u0d85\u0daf\u0da7 \u0dc0\u0dc3\u0dbb\u0dba\u0dd2",
    "\u0d91\u0d82\u0d9c\u0dbd\u0db1\u0dca\u0dad\u0dba\u0da7 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 55\u0d9a \u0da2\u0dba\u0d9a\u0dca",
    "\u0db4\u0dac\u0dd4\u0dc0\u0dc3\u0dca\u0db1\u0dd4\u0dc0\u0dbb \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0db4\u0dcf\u0dbd\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db4\u0dbb\u0dcf\u0daf\u0dba\u0dd2",
    "\u0d86\u0db4\u0daf\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0dc3\u0dc4\u0db1 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd3\u0db8 \u0db8\u0dd9\u0db1\u0dca\u0db8 \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dad\u0dca \u0dbb\u0da2\u0dba\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u2013 \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2",
    "\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a 4\u0d9a\u0da7 \u0db1\u0dcf\u0dba\u0dba\u0dcf\u0db8\u0dda \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8\u0dca",
    "\u0dbb\u0da7 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d9c\u0dad\u0dca \u0dc0\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da7\u0dad\u0db8 \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0da7 \u0d85\u0daf\u0da7 \u0dc0\u0dc3\u0dbb\u0dba\u0dd2",
    "\u0d91\u0d82\u0d9c\u0dbd\u0db1\u0dca\u0dad\u0dba\u0da7 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 55\u0d9a \u0da2\u0dba\u0d9a\u0dca",
    "\u0db4\u0dac\u0dd4\u0dc0\u0dc3\u0dca\u0db1\u0dd4\u0dc0\u0dbb \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0db4\u0dcf\u0dbd\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db4\u0dbb\u0dcf\u0daf\u0dba\u0dd2",
    "\u0d86\u0db4\u0daf\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0dc3\u0dc4\u0db1 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd3\u0db8 \u0db8\u0dd9\u0db1\u0dca\u0db8 \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dad\u0dca \u0dbb\u0da2\u0dba\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u2013 \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2",
    "\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a 4\u0d9a\u0da7 \u0db1\u0dcf\u0dba\u0dba\u0dcf\u0db8\u0dda \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8\u0dca",
    "\u0dbb\u0da7 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d9c\u0dad\u0dca \u0dc0\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da7\u0dad\u0db8 \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0da7 \u0d85\u0daf\u0da7 \u0dc0\u0dc3\u0dbb\u0dba\u0dd2",
    "\u0d91\u0d82\u0d9c\u0dbd\u0db1\u0dca\u0dad\u0dba\u0da7 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 55\u0d9a \u0da2\u0dba\u0d9a\u0dca",
    "\u0db4\u0dac\u0dd4\u0dc0\u0dc3\u0dca\u0db1\u0dd4\u0dc0\u0dbb \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0db4\u0dcf\u0dbd\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db4\u0dbb\u0dcf\u0daf\u0dba\u0dd2",
    "\u0d86\u0db4\u0daf\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0dc3\u0dc4\u0db1 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd3\u0db8 \u0db8\u0dd9\u0db1\u0dca\u0db8 \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dad\u0dca \u0dbb\u0da2\u0dba\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u2013 \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2",
    "\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a 4\u0d9a\u0da7 \u0db1\u0dcf\u0dba\u0dba\u0dcf\u0db8\u0dda \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8\u0dca",
    "\u0dbb\u0da7 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d9c\u0dad\u0dca \u0dc0\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da7\u0dad\u0db8 \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0da7 \u0d85\u0daf\u0da7 \u0dc0\u0dc3\u0dbb\u0dba\u0dd2",
    "\u0d91\u0d82\u0d9c\u0dbd\u0db1\u0dca\u0dad\u0dba\u0da7 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 55\u0d9a \u0da2\u0dba\u0d9a\u0dca",
    "\u0db4\u0dac\u0dd4\u0dc0\u0dc3\u0dca\u0db1\u0dd4\u0dc0\u0dbb \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0db4\u0dcf\u0dbd\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db4\u0dbb\u0dcf\u0daf\u0dba\u0dd2",
    "\u0d86\u0db4\u0daf\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0dc3\u0dc4\u0db1 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd3\u0db8 \u0db8\u0dd9\u0db1\u0dca\u0db8 \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dad\u0dca \u0dbb\u0da2\u0dba\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u2013 \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2",
    "\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a 4\u0d9a\u0da7 \u0db1\u0dcf\u0dba\u0dba\u0dcf\u0db8\u0dda \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8\u0dca",
    "\u0dbb\u0da7 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d9c\u0dad\u0dca \u0dc0\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da7\u0dad\u0db8 \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0da7 \u0d85\u0daf\u0da7 \u0dc0\u0dc3\u0dbb\u0dba\u0dd2",
    "\u0d91\u0d82\u0d9c\u0dbd\u0db1\u0dca\u0dad\u0dba\u0da7 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 55\u0d9a \u0da2\u0dba\u0d9a\u0dca",
    "\u0db4\u0dac\u0dd4\u0dc0\u0dc3\u0dca\u0db1\u0dd4\u0dc0\u0dbb \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0db4\u0dcf\u0dbd\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db4\u0dbb\u0dcf\u0daf\u0dba\u0dd2",
    "\u0d86\u0db4\u0daf\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0dc3\u0dc4\u0db1 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd3\u0db8 \u0db8\u0dd9\u0db1\u0dca\u0db8 \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dad\u0dca \u0dbb\u0da2\u0dba\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u2013 \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2",
    "\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a 4\u0d9a\u0da7 \u0db1\u0dcf\u0dba\u0dba\u0dcf\u0db8\u0dda \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8\u0dca",
    "\u0dbb\u0da7 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d9c\u0dad\u0dca \u0dc0\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da7\u0dad\u0db8 \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0da7 \u0d85\u0daf\u0da7 \u0dc0\u0dc3\u0dbb\u0dba\u0dd2",
    "\u0d91\u0d82\u0d9c\u0dbd\u0db1\u0dca\u0dad\u0dba\u0da7 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 55\u0d9a \u0da2\u0dba\u0d9a\u0dca",
    "\u0db4\u0dac\u0dd4\u0dc0\u0dc3\u0dca\u0db1\u0dd4\u0dc0\u0dbb \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0db4\u0dcf\u0dbd\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db4\u0dbb\u0dcf\u0daf\u0dba\u0dd2",
    "\u0d86\u0db4\u0daf\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0dc3\u0dc4\u0db1 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd3\u0db8 \u0db8\u0dd9\u0db1\u0dca\u0db8 \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dad\u0dca \u0dbb\u0da2\u0dba\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u2013 \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2",
    "\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a 4\u0d9a\u0da7 \u0db1\u0dcf\u0dba\u0dba\u0dcf\u0db8\u0dda \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8\u0dca",
    "\u0dbb\u0da7 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d9c\u0dad\u0dca \u0dc0\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da7\u0dad\u0db8 \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0da7 \u0d85\u0daf\u0da7 \u0dc0\u0dc3\u0dbb\u0dba\u0dd2",
